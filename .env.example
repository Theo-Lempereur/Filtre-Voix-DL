# Configuration de l'API de débruitage (serve/server.py).
# Copier ce fichier en `.env` et adapter les valeurs. Le `.env` est ignoré par git.

# (requis) Chemin absolu vers le checkpoint .pt à servir.
# Choisir un run compatible avec le model.py actuel (GroupNorm) :
# ex. teste, p1_loss_2, p2_combo_mrstft.
CKPT_PATH=G:\Mon Drive\Filtre-Voix-DL\checkpoints\teste\best.pt

# (option) "cuda" ou "cpu". Si vide ou absent : auto-détection (cuda si dispo).
DEVICE=cpu

# (option) Origines autorisées pour CORS, séparées par des virgules.
# "*" = tout autorisé (pratique en dev). En prod : https://monsite.com
CORS_ORIGINS=*

# ─────────────────────────────────────────────────────────────────────────────
# Modèles NVIDIA hébergés (BNR + Studio Voice) — optionnel
# ─────────────────────────────────────────────────────────────────────────────
# (option) Notre clé NVIDIA PARTAGÉE. Sert de repli quand l'utilisateur ne
# fournit pas la sienne. Soumise alors au quota journalier (FREE_DAILY_LIMIT).
# Obtenir une clé gratuite (préfixe nvapi-) sur https://build.nvidia.com .
# ⚠️ Ne committez JAMAIS cette valeur. Ce .env est ignoré par git.
NVIDIA_API_KEY=

# (requis pour utiliser les modèles NVIDIA) function-id de chaque NIM, copié
# depuis la page « API » du modèle sur build.nvidia.com.
NVIDIA_BNR_FUNCTION_ID=
NVIDIA_STUDIOVOICE_FUNCTION_ID=

# (option) Cible gRPC NVCF et timeout (s). Valeurs par défaut ci-dessous.
NVIDIA_GRPC_TARGET=grpc.nvcf.nvidia.com:443
NVIDIA_GRPC_TIMEOUT=60

# (option) Limite journalière par IP en mode clé partagée. Défaut : 5.
FREE_DAILY_LIMIT=5

# (option) Emplacement du fichier SQLite de quota. Défaut : quota.sqlite3 à la racine.
QUOTA_DB_PATH=
